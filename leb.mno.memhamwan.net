/interface bridge
add fast-forward=no mtu=1500 name=bridge1
/interface vrrp
add authentication=ah interface=ether1 name=vrrp1 version=2
/interface lte apn
set [ find default=yes ] ip-type=ipv4 use-network-apn=no
/interface wireless security-profiles
set [ find default=yes ] supplicant-identity=MikroTik
add authentication-types=wpa-psk,wpa2-psk eap-methods="" management-protection=allowed mode=dynamic-keys name=hamwan supplicant-identity=""
/interface wireless
set [ find default-name=wlan1 ] adaptive-noise-immunity=ap-and-client-mode band=5ghz-onlyac country="united states" disabled=no frequency=auto frequency-mode=superchannel mtu=1600 rx-chains=0,1 security-profile=hamwan ssid=HamWAN-leb-mno station-roaming=enabled tx-chains=0,1 wireless-protocol=802.11
/routing bgp template
set default disabled=no output.network=bgp-networks
/routing ospf instance
add disabled=no in-filter-chain=AMPR-default name=default-v2 originate-default=if-installed out-filter-chain=AMPR-default redistribute=connected,ospf,bgp router-id=44.34.131.140
/routing ospf area
add disabled=no instance=default-v2 name=backbone-v2
/snmp community
set [ find default=yes ] addresses=44.0.0.0/8
/system logging action
set 0 memory-lines=1
set 3 bsd-syslog=yes
add bsd-syslog=yes name=centrallogging remote=44.34.128.171 syslog-facility=syslog target=remote
/user group
add name=netops-backup-ro policy="ssh,read,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!api,!romon,!rest-api"
add name=netops-backup-full policy="ssh,read,sensitive,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!api,!romon,!rest-api"
add name=mktxp_group policy="read,api,!local,!telnet,!ssh,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
add name=netops-ansible policy="ssh,ftp,read,write,policy,test,api,!local,!telnet,!reboot,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
#error exporting "/interface/bridge/calea"
/interface bridge port
add bridge=bridge1 ingress-filtering=no interface=wlan1
/ip neighbor discovery-settings
set discover-interface-list=none
/ip settings
set max-neighbor-entries=8192
/ipv6 settings
set disable-ipv6=yes max-neighbor-entries=8192
/interface ovpn-server server
set auth=sha1,md5
/ip address
add address=44.34.129.39/27 interface=ether1 network=44.34.129.32
add address=44.34.129.33 interface=vrrp1 network=44.34.129.33
add address=44.34.131.140 interface=bridge1 network=44.34.131.141
/ip dns
set servers=8.8.8.8
#error exporting "/ip/firewall/calea"
/ip firewall mangle
add action=change-mss chain=forward new-mss=1378 passthrough=yes protocol=tcp tcp-flags=syn tcp-mss=!0-1378
add action=change-mss chain=output new-mss=1378 passthrough=yes protocol=tcp tcp-flags=syn tcp-mss=!0-1378
/ip service
set telnet disabled=yes
set ftp disabled=yes
set www disabled=yes
set ssh port=222
set api address=44.34.128.45/32 disabled=yes
set winbox disabled=yes
set api-ssl address=44.34.128.45/32 certificate=api-ssl
/ip socks
set connection-idle-timeout=1m max-connections=255 port=48324
/ip ssh
set forwarding-enabled=remote strong-crypto=yes
/routing bfd configuration
add disabled=no interfaces=all min-rx=200ms min-tx=200ms multiplier=5
/routing filter rule
add chain=AMPR-default disabled=no rule="if (dst in 44.0.0.0/8 && dst-len in 8-32) { accept; }"
add chain=AMPR-default disabled=no rule="if (dst == 0.0.0.0/0) { accept; }"
add chain=AMPR-default disabled=no rule="reject;"
/routing ospf interface-template
add area=backbone-v2 auth=md5 auth-id=1 auth-key=REDACTED cost=50 disabled=no interfaces=ether1 networks=44.34.129.32/27 priority=1 use-bfd=no
add area=backbone-v2 disabled=no interfaces=vrrp1 networks=44.34.129.33 priority=1
add area=backbone-v2 auth=md5 auth-id=1 auth-key=REDACTED cost=50 disabled=no interfaces=bridge1 networks=44.34.131.141 priority=1 type=ptp use-bfd=no
/snmp
set contact="#HamWAN on irc.freenode.org" enabled=yes
/system clock
set time-zone-autodetect=no time-zone-name=America/Chicago
/system identity
set name=leb.mno.memhamwan.net
/system leds
set 1 interface=wlan1
/system logging
set 0 disabled=yes
set 1 disabled=yes
set 3 action=memory disabled=yes
add action=remote disabled=yes topics=system
add action=remote disabled=yes topics=error
add action=remote topics=warning
add action=remote disabled=yes topics=critical
add action=remote disabled=yes topics=account
/system note
set show-at-login=no
/system ntp client
set enabled=yes
/system ntp client servers
add address=44.34.128.181
add address=44.34.133.3
add address=162.159.200.1
add address=162.159.200.123
/tool bandwidth-server
set authenticate=no enabled=no
/tool mac-server
set allowed-interface-list=none
/tool mac-server mac-winbox
set allowed-interface-list=none
/tool mac-server ping
set enabled=no
/tool romon
set enabled=yes
