/interface list
add comment=defconf name=WAN
add comment=defconf name=LAN
/interface lte apn
set [ find default=yes ] ip-type=ipv4 use-network-apn=no
/interface wireless channels
add band=5ghz-onlyn comment="Cell sites radiate this at 0 degrees (north)" frequency=5920 list=HamWAN name=Sector1-5 width=5
add band=5ghz-onlyn comment="Cell sites radiate this at 120 degrees (south-east)" frequency=5900 list=HamWAN name=Sector2-5 width=5
add band=5ghz-onlyn comment="Cell sites radiate this at 240 degrees (south-west)" frequency=5880 list=HamWAN name=Sector3-5 width=5
add band=5ghz-onlyn comment="Cell sites radiate this at 0 degrees (north)" frequency=5920 list=HamWAN name=Sector1-10 width=10
add band=5ghz-onlyn comment="Cell sites radiate this at 120 degrees (south-east)" frequency=5900 list=HamWAN name=Sector2-10 width=10
add band=5ghz-onlyn comment="Cell sites radiate this at 240 degrees (south-west)" frequency=5880 list=HamWAN name=Sector3-10 width=10
/interface wireless security-profiles
set [ find default=yes ] supplicant-identity=MikroTik
add authentication-types=wpa-psk,wpa2-psk eap-methods="" management-protection=allowed mode=dynamic-keys name=hamwan supplicant-identity=""
/interface wireless
set [ find default-name=wlan1 ] adaptive-noise-immunity=ap-and-client-mode antenna-gain=5 band=5ghz-a/n compression=yes country="united states3" disabled=no distance=10 frequency=5805 frequency-mode=superchannel hide-ssid=yes hw-retries=15 installation=outdoor mode=station-bridge nv2-cell-radius=10 radio-name=sco.ftn.memhamwan.net security-profile=hamwan ssid=HamWAN-ftn-sco tdma-period-size=10 wireless-protocol=nv2-nstreme-802.11
/ip pool
add name=default-dhcp ranges=192.168.88.10-192.168.88.254
add name=dhcp-pool ranges=192.168.88.100-192.168.88.199
/ip smb users
set [ find default=yes ] disabled=yes
/routing bgp template
set default disabled=no output.network=bgp-networks
/routing ospf instance
add disabled=no in-filter-chain=AMPR-default name=default-v2 originate-default=if-installed out-filter-chain=AMPR-default redistribute=connected,ospf,bgp router-id=44.34.129.195
/routing ospf area
add disabled=no instance=default-v2 name=backbone-v2
/snmp community
set [ find default=yes ] addresses=153.66.103.187/32
/system logging action
set 3 remote=44.34.128.45 remote-log-format=syslog
/user group
add name=netops-backup-ro policy="ssh,read,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!api,!romon,!rest-api"
add name=netops-backup-full policy="ssh,read,sensitive,!local,!telnet,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!api,!romon,!rest-api"
add name=mktxp_group policy="read,api,!local,!telnet,!ssh,!ftp,!reboot,!write,!policy,!test,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
add name=netops-ansible policy="ssh,ftp,read,write,policy,test,api,!local,!telnet,!reboot,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api"
/ip firewall connection tracking
set udp-timeout=10s
/ip neighbor discovery-settings
set discover-interface-list=LAN
/ip settings
set max-neighbor-entries=8192
/ipv6 settings
set disable-ipv6=yes max-neighbor-entries=8192
/interface list member
add comment=defconf interface=ether1 list=LAN
add comment=defconf interface=wlan1 list=WAN
/interface ovpn-server server
add auth=sha1,md5 mac-address=FE:E5:4F:A3:F7:80 name=ovpn-server1
/ip address
add address=192.168.88.1/24 comment=defconf interface=ether1 network=192.168.88.0
add address=44.34.129.195/28 interface=ether1 network=44.34.129.192
add address=44.34.131.147 interface=wlan1 network=44.34.131.146
/ip dhcp-client
add add-default-route=no comment=defconf disabled=yes interface=wlan1
/ip dns
set servers=8.8.8.8
/ip dns static
add address=192.168.88.1 comment=defconf name=router.lan type=A
/ip firewall mangle
add action=change-mss chain=output new-mss=1378 protocol=tcp tcp-flags=syn tcp-mss=!0-1378
add action=change-mss chain=forward new-mss=1378 protocol=tcp tcp-flags=syn tcp-mss=!0-1378
/ip ipsec profile
set [ find default=yes ] dpd-interval=2m dpd-maximum-failures=5
/ip service
set ftp disabled=yes
set telnet disabled=yes
set www disabled=yes
set ssh port=222
set winbox disabled=yes
set api address=44.34.128.45/32 disabled=yes
set api-ssl address=44.34.128.45/32 certificate=api-ssl
/ip smb shares
set [ find default=yes ] directory=/pub
/ip ssh
set strong-crypto=yes
/routing bfd configuration
add disabled=no interfaces=all min-rx=200ms min-tx=200ms multiplier=5
/routing filter rule
add chain=AMPR-default disabled=no rule="if (dst in 44.0.0.0/8 && dst-len in 8-32) { accept; }"
add chain=AMPR-default disabled=no rule="if (dst == 0.0.0.0/0) { accept; }"
add chain=AMPR-default disabled=no rule="reject;"
/routing ospf interface-template
add area=backbone-v2 auth=md5 auth-id=1 cost=10 disabled=no interfaces=ether1 networks=44.34.129.192/28 priority=1 use-bfd=no
add area=backbone-v2 auth=md5 auth-id=1 cost=10 disabled=no interfaces=wlan1 networks=44.34.131.146 priority=2 type=ptp use-bfd=no
/snmp
set contact=ryan@turnrye.com enabled=yes location=sco.ftn
/system clock
set time-zone-name=America/New_York
/system identity
set name=sco.ftn.memhamwan.net
/system logging
set 3 action=memory
add action=echo disabled=yes topics=!ssh,!ospf
add action=remote topics=system
add action=remote topics=error
add action=remote topics=warning
add action=remote topics=critical
add action=remote topics=account
/system ntp client
set enabled=yes
/system ntp client servers
add address=44.34.128.181
add address=44.34.133.3
add address=162.159.200.1
add address=162.159.200.123
/tool bandwidth-server
set authenticate=no enabled=no
/tool mac-server
set allowed-interface-list=none
/tool mac-server mac-winbox
set allowed-interface-list=none
/tool romon
set enabled=yes
