/interface bridge
add admin-mac=48:8F:5A:E1:D0:FA auto-mac=no comment=defconf name=bridge port-cost-mode=short
add name=user-dhcp
/interface ethernet
set [ find default-name=sfp-sfpplus1 ] auto-negotiation=no speed=1G-baseX
/interface vrrp
