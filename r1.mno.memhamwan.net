add auth=sha1,md5 mac-address=FE:7C:63:26:D2:0B name=ovpn-server1
/ip address
add address=44.34.129.34/27 interface=bridge1 network=44.34.129.32
add address=44.34.129.33 interface=*23 network=44.34.129.33
